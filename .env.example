# StoneHead AI — Environment Variables
# ======================================
# Copy to .env and fill in all values.

# --- Supabase (Thread 1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider (Thread 2) ---
OPENROUTER_API_KEY=

# Model used for chat completions (OpenRouter slug). Falls back to a
# sensible default if unset.
AI_MODEL=

# Max tokens for the main chat completion. Controls how long replies can
# run before being cut off. Defaults to 250 if unset. Set MAX_TOKENS=250
# in production (Netlify env) to avoid deep-convo mid-sentence truncation.
MAX_TOKENS=250

# --- Payment System (Threads 3 & 4) ---
# Shared secret for the subscription callback. Must match the same value
# set on the external payment page. Generate a random string.
CALLBACK_SECRET=

# URL of the external payment page (where users paste their payment code).
# Thread 3's generate-code endpoint appends ?code=XXXXX to this URL.
PAYMENT_PAGE_URL=https://pay.stoneheadai.com
