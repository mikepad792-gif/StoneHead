# StoneHead AI — Environment Variables
# ======================================
# Copy to .env and fill in all values.

# --- Supabase (Thread 1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider (Thread 2) ---
OPENROUTER_API_KEY=

# --- Models used for various application functions ---
# AI_MODEL is the shared default. A function-specific value overrides it;
# blank function-specific values inherit AI_MODEL. Any configured model that
# fails is retried once with AI_MODEL_FALLBACK.
#
# REQUIRED: every function must resolve to a model. If AI_MODEL is blank and a
# function's own variable is blank too, lib/config.js THROWS at startup rather
# than quietly running on an unintended endpoint. Set AI_MODEL at minimum.
# Main/default model
AI_MODEL=
# Main chat completions model (read in config.js; inherits AI_MODEL if blank)
AI_MODEL_CHAT=
# Title generation model
AI_MODEL_TITLE=
# Summarizing model
AI_MODEL_SUMMARY=
# Memory consolidation model
AI_MODEL_CONSOLIDATION=

# Cross-model retry target, used when a configured model fails. An env var on
# purpose: the previous hardcoded fallback was delisted from OpenRouter, and
# re-pointing it should not require a code change and a deploy.
# Defaults to anthropic/claude-haiku-4.5 when unset.
AI_MODEL_FALLBACK=anthropic/claude-haiku-4.5

# Per-attempt OpenRouter timeout in milliseconds, for the BACKGROUND paths
# (title generation, session memory, consolidation). A timed-out configured
# model is retried once with AI_MODEL_FALLBACK. Defaults to 20000 when unset.
OPENROUTER_TIMEOUT_MS=20000

# Per-attempt timeout for the SYNCHRONOUS chat path. Netlify kills a
# synchronous function at 10s, so this must leave room for the cross-model
# retry inside that budget — a 20s value means Netlify wins the race and the
# retry never runs. Defaults to 8000 when unset.
OPENROUTER_TIMEOUT_CHAT_MS=8000

# Max output-token budget for the main chat completion. Defaults to 700 if
# unset, and 700 is the recommended production value. Do NOT set this below
# ~600: the model sometimes front-loads hidden reasoning/scaffold that eats
# the budget before the real reply, truncating it mid-sentence — a low value
# here CAUSES the truncation it might look like it prevents. The prompt
# enforces brevity, so this is a ceiling, not a target.
# (If MAX_TOKENS=250 is currently set in the Netlify env, DELETE it.)
MAX_TOKENS=700

# Public origin of the deployed site, no trailing slash. Only consumer today
# is the password-reset email's redirect target (<SITE_URL>/reset), which must
# also appear in Supabase → Authentication → URL Configuration → Redirect URLs.
# Defaults to https://stoneheadai.com when unset, so production needs nothing.
SITE_URL=https://stoneheadai.com

# --- Internal ---
# Shared secret for internal function-to-function invocation
# (chat-send -> chat-postwork-background). Generate a random string.
# Remember to set it in the Netlify env before deploy.
INTERNAL_TASK_SECRET=

# --- Payment System (Threads 3 & 4) ---
# Shared secret for the subscription callback. Must match the same value
# set on the external payment page. Generate a random string.
CALLBACK_SECRET=

# URL of the external payment page (where users paste their payment code).
# Thread 3's generate-code endpoint appends ?code=XXXXX to this URL.
PAYMENT_PAGE_URL=https://pay.stoneheadai.com
